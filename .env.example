# Database Configuration
DATABASE_URL=postgresql://postgres:password@postgres:5432/hmt_db
POSTGRES_DB=hmt_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# API Gateway Configuration
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=3000
API_GATEWAY_JWT_SECRET=your_jwt_secret_here

# Email Service Configuration
EMAIL_SERVICE_HOST=0.0.0.0
EMAIL_SERVICE_GRPC_PORT=5000

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM="HMT System <noreply@hmt.com>"

# Environment
NODE_ENV=development
LOG_LEVEL=debug

# Docker Configuration
COMPOSE_PROJECT_NAME=hmt
DOCKER_BUILDKIT=1

# Monitoring
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true

# SSL Configuration (for production)
SSL_ENABLED=false
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/key.pem

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
